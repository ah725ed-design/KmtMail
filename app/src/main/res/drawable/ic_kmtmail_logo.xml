<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Blue Glow behind the envelope -->
    <path
        android:pathData="M54,12 A42,42 0 1 0 54,96 A42,42 0 1 0 54,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:startX="54"
                android:startY="54"
                android:endX="54"
                android:endY="96">
                <item android:offset="0.0" android:color="#4D5E7CE2"/>
                <item android:offset="0.5" android:color="#1F5E7CE2"/>
                <item android:offset="1.0" android:color="#005E7CE2"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Mail Envelope Body -->
    <path
        android:pathData="M29,30 H79 C83.4,30 87,33.6 87,38 V70 C87,74.4 83.4,78 79,78 H29 C24.6,78 21,74.4 21,70 V38 C21,33.6 24.6,30 29,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="21"
                android:startY="30"
                android:endX="87"
                android:endY="78">
                <item android:offset="0.0" android:color="#1B2233"/>
                <item android:offset="1.0" android:color="#0D1322"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom Inner Fold Accent Seams -->
    <path
        android:pathData="M23,75.5 L46,58 M85,75.5 L62,58"
        android:strokeWidth="2.5"
        android:strokeColor="#305E7CE2"
        android:strokeLineCap="round"/>

    <!-- Envelope Flap / Top V-Fold -->
    <path
        android:pathData="M23,32.5 L51.5,55.5 C53.1,56.8 54.9,56.8 56.5,55.5 L85,32.5"
        android:strokeWidth="4.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="23"
                android:startY="32.5"
                android:endX="85"
                android:endY="55.5">
                <item android:offset="0.0" android:color="#5E7CE2"/>
                <item android:offset="0.5" android:color="#8CB8FF"/>
                <item android:offset="1.0" android:color="#38BDF8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Envelope Outer Border -->
    <path
        android:pathData="M29,30 H79 C83.4,30 87,33.6 87,38 V70 C87,74.4 83.4,78 79,78 H29 C24.6,78 21,74.4 21,70 V38 C21,33.6 24.6,30 29,30 Z"
        android:strokeWidth="3.2"
        android:strokeColor="#5E7CE2"/>

    <!-- Flap Center Accent Dot -->
    <path
        android:pathData="M54,58 A2,2 0 1 0 54,54 A2,2 0 1 0 54,58 Z"
        android:fillColor="#8CB8FF"/>
</vector>
